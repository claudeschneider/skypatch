{
  "name": "skypatch",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run source && vite build && python3 scripts/build-pwa.py && python3 scripts/build-site.py",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "source": "python3 scripts/package-source.py",
    "test:pwa": "playwright test --config playwright.pwa.config.js",
    "release": "python3 scripts/release.py"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "vite": "6.4.3"
  },
  "dependencies": {
    "astronomy-engine": "2.1.19"
  }
}
